<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ date_long }} · AI &amp; P&amp;C Insurance Brief</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,600;1,6..72,400&family=IBM+Plex+Mono:wght@400;500&family=Inter:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:#0E1A26; --muted:#5B6B77; --rule:#DDE2E0; --wash:#F1F3F2;
    --marine:#1B4A6B; --ochre:#9A6B12; --oxblood:#6E2436;
    --display:"Newsreader",Georgia,serif;
    --body:"Inter",-apple-system,"Segoe UI",sans-serif;
    --mono:"IBM Plex Mono",ui-monospace,Consolas,monospace;
  }
  *{box-sizing:border-box}
  body{margin:0;background:var(--wash);color:var(--ink);font-family:var(--body);
       font-size:17px;line-height:1.6;-webkit-font-smoothing:antialiased}
  .sheet{max-width:760px;margin:0 auto;background:#fff;border-left:1px solid var(--rule);
         border-right:1px solid var(--rule);min-height:100vh}
  .pad{padding:0 40px}
  @media(max-width:640px){.pad{padding:0 20px}body{font-size:16px}}
  header{padding:40px 0 18px;border-bottom:3px double var(--ink);margin-bottom:0}
  .eyebrow{font-family:var(--mono);font-size:11px;letter-spacing:1.6px;
           text-transform:uppercase;color:var(--marine)}
  h1{font-family:var(--display);font-weight:400;font-size:clamp(30px,6vw,44px);
     line-height:1.08;margin:10px 0 8px;letter-spacing:-0.01em}
  .meta{font-family:var(--mono);font-size:11px;color:var(--muted)}
  .verdict{font-family:var(--display);font-size:clamp(20px,3.4vw,25px);line-height:1.45;
           padding:28px 0;border-bottom:1px solid var(--rule)}
  .verdict .label{display:block;font-family:var(--mono);font-size:11px;letter-spacing:1.4px;
                  text-transform:uppercase;color:var(--ochre);margin-bottom:10px}

  /* the ladder: every mover indexed by segment and severity before you read on */
  .ladder{padding:22px 0;border-bottom:1px solid var(--rule)}
  .ladder a{display:flex;gap:14px;align-items:baseline;text-decoration:none;color:inherit;
            padding:7px 0;border-bottom:1px dotted var(--rule)}
  .ladder a:last-child{border-bottom:none}
  .ladder a:hover .lt{border-bottom:1px solid var(--ochre)}
  .lseg{font-family:var(--mono);font-size:10px;letter-spacing:1px;text-transform:uppercase;
        color:var(--marine);width:104px;flex:none}
  .lt{font-size:15px}
  .meter{display:inline-flex;gap:3px;flex:none;transform:translateY(-1px)}
  .meter i{width:8px;height:8px;background:#E3E6E4;display:block}
  .meter i.on{background:var(--ochre)}

  article{padding:34px 0;border-bottom:1px solid var(--rule)}
  article h2{font-family:var(--display);font-weight:600;font-size:clamp(23px,4vw,30px);
             line-height:1.2;margin:10px 0 14px;letter-spacing:-0.01em}
  .tag{display:flex;gap:12px;align-items:center;font-family:var(--mono);font-size:10px;
       letter-spacing:1.2px;text-transform:uppercase;color:var(--marine)}
  .tag .src{color:var(--muted);letter-spacing:0.4px;text-transform:none}
  .sowhat{border-left:3px solid var(--marine);padding:4px 0 4px 16px;margin:18px 0;
          color:var(--marine)}
  .sowhat b{display:block;font-family:var(--mono);font-size:10px;letter-spacing:1.2px;
            text-transform:uppercase;margin-bottom:3px}
  .deeper{background:#FBFCFB;border:1px solid var(--rule);padding:20px;margin:18px 0}
  .deeper b{display:block;font-family:var(--mono);font-size:10px;letter-spacing:1.2px;
            text-transform:uppercase;color:var(--ochre);margin-bottom:8px}
  .next{font-family:var(--mono);font-size:12px;color:var(--muted);line-height:1.6}
  .links{margin-top:16px;font-family:var(--mono);font-size:12px}
  .links a{color:var(--ink);text-decoration:none;border-bottom:1px solid var(--ochre);
           margin-right:18px}
  .links a:hover{background:#FBF4E6}
  section.block{padding:30px 0;border-bottom:1px solid var(--rule)}
  section.block > b{display:block;font-family:var(--mono);font-size:11px;letter-spacing:1.4px;
                    text-transform:uppercase;margin-bottom:14px}
  .reg > b{color:var(--oxblood)} .rad > b{color:var(--muted)}
  .line{font-size:15px;padding:6px 0}
  .line a{font-family:var(--mono);font-size:10px;color:var(--muted);text-decoration:none}
  .line a:hover{color:var(--ink)}
  .close{background:var(--ink);color:#fff;padding:34px 40px;margin-top:0}
  .close b{font-family:var(--mono);font-size:11px;letter-spacing:1.4px;text-transform:uppercase;
           color:#8FA9BC;display:block;margin-bottom:10px}
  .close p{font-family:var(--display);font-size:22px;line-height:1.4;margin:0}
  footer{padding:26px 0 50px;font-family:var(--mono);font-size:11px;color:var(--muted);line-height:1.8}
  footer a{color:var(--marine)}
  a:focus-visible{outline:2px solid var(--ochre);outline-offset:3px}
</style>
</head>
<body>
<div class="sheet">
  <div class="pad">
    <header>
      <div class="eyebrow">AI &amp; P&amp;C Insurance · Daily Brief</div>
      <h1>{{ date_long }}</h1>
      <div class="meta">{{ stats.sources }} sources scanned · {{ stats.qualified }} qualified · {{ brief.movers|length }} movers · generated {{ generated_at }}</div>
    </header>

    <div class="verdict"><span class="label">The verdict</span>{{ brief.verdict }}</div>

    {% if brief.movers %}
    <nav class="ladder" aria-label="Today's movers">
      {% for item in brief.movers %}
      <a href="#item-{{ loop.index }}">
        <span class="lseg">{{ item.segment|default('Signal') }}</span>
        <span class="meter" aria-label="severity {{ item.severity|default(3) }} of 5">
          {% for n in range(1,6) %}<i class="{{ 'on' if n <= (item.severity|default(3)) else '' }}"></i>{% endfor %}
        </span>
        <span class="lt">{{ item.headline }}</span>
      </a>
      {% endfor %}
    </nav>

    {% for item in brief.movers %}
    <article id="item-{{ loop.index }}">
      <div class="tag">
        <span>{{ item.segment|default('Signal') }}</span>
        <span class="meter">{% for n in range(1,6) %}<i class="{{ 'on' if n <= (item.severity|default(3)) else '' }}"></i>{% endfor %}</span>
        <span class="src">{{ item.source }}</span>
      </div>
      <h2>{{ item.headline }}</h2>
      <p>{{ item.what_happened }}</p>
      <div class="sowhat"><b>So what</b>{{ item.so_what }}</div>
      <div class="deeper"><b>Deeper</b>{{ item.deeper }}</div>
      {% if item.watch_next %}<div class="next">Watch next: {{ item.watch_next }}</div>{% endif %}
      <div class="links">
        <a href="{{ item.url }}" rel="noopener">Read the source</a>
        <a href="{{ item.ask_link }}" rel="noopener">Ask Claude about this</a>
      </div>
    </article>
    {% endfor %}
    {% endif %}

    {% if brief.regulatory %}
    <section class="block reg"><b>Supervisory watch</b>
      {% for item in brief.regulatory %}
      <div class="line">{{ item.line }} <a href="{{ item.url }}" rel="noopener">[{{ item.source }}]</a></div>
      {% endfor %}
    </section>
    {% endif %}

    {% if brief.radar %}
    <section class="block rad"><b>On the radar</b>
      {% for item in brief.radar %}
      <div class="line">{{ item.line }} <a href="{{ item.url }}" rel="noopener">[{{ item.source }}]</a></div>
      {% endfor %}
    </section>
    {% endif %}
  </div>

  {% if brief.boardroom_question %}
  <div class="close"><b>Ask your own shop today</b><p>{{ brief.boardroom_question }}</p></div>
  {% endif %}

  <div class="pad"><footer>
    <a href="./index.html">All editions</a><br>
    Assembled from public RSS and news feeds, ranked by keyword scoring, written by Claude.
    Every link points to the original publisher. Verify before you quote any figure in a deck.
  </footer></div>
</div>
</body>
</html>
